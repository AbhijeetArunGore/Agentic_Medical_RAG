# ==============================================================================
# Agentic Medical RAG - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL API KEYS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# --- Execution & Offline Mode ---
# When true, uses deterministic offline responses without external API calls
MOCK_LLM=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Cloud LLM Provider Credentials (Optional; ignored when MOCK_LLM=true) ---
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
MODEL_NAME=gpt-4o-mini

# --- Embeddings & Vector Storage ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_db
COLLECTION_NAME=clinical_guidelines

# --- Ingestion & Chunking Strategy ---
# Chunking strategy: recursive, fixed, structure_aware
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=10

# --- Retrieval Configuration ---
# Retrieval mode: dense, hybrid, bm25
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# --- Multi-Agent Safety & Guardrails ---
MAX_AGENT_ITERATIONS=5
ENABLE_CITATION_VALIDATION=true
ABSTENTION_THRESHOLD=0.30

# --- API Service Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_REQUEST_TIMEOUT_SECONDS=30
CORS_ORIGINS=*
